<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <PackageId>LlmChamber.Avalonia</PackageId>
    <Description>LlmChamber Avalonia UI用チャットコントロール。Win/macOS/Linuxクロスプラットフォーム対応。</Description>
    <IsPackable>true</IsPackable>
    <RootNamespace>LlmChamber.Avalonia</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Microsoft.Extensions.DependencyInjection.Abstractions / Microsoft.Extensions.Options は
       .NET 11 の共有フレームワーク (Microsoft.NETCore.App) に含まれるため PackageReference しない。
       明示参照すると NU1510（フレームワーク提供パッケージの冗長参照）になる。.NET 8 系ターゲットは廃止済み。 -->

  <!-- CRDebugger方式: Coreソース取り込み -->
  <ItemGroup>
    <Compile Include="..\LlmChamber.Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\LlmChamber.Core\obj\**;..\LlmChamber.Core\bin\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
  </ItemGroup>
</Project>
